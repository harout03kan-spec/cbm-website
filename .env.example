# ─────────────────────────────────────────────────────────────
# Environment variables (placeholders only — never commit real values)
# ─────────────────────────────────────────────────────────────

# Google reCAPTCHA v3 — PUBLIC site key.
# Safe to expose in the frontend bundle. Used by the browser to obtain a token.
VITE_RECAPTCHA_SITE_KEY=your_public_recaptcha_site_key_here

# IMPORTANT: the reCAPTCHA *secret* key is NOT a VITE_ variable and must NEVER
# appear in frontend code or this file's deployed bundle. It is used only by the
# server when verifying tokens at https://www.google.com/recaptcha/api/siteverify
# Configure it as a server-side environment variable on your backend instead, e.g.:
#   RECAPTCHA_SECRET_KEY=your_server_side_secret_key_here   (server env only)

# ─────────────────────────────────────────────────────────────
# Internal CRM (/crm) passcode — OPTIONAL.
# Client-side gate for the internal CRM tool. This is a lightweight obfuscation
# hash, NOT real security (the CRM ships in the public bundle). If unset, a weak
# default ("123") is used, so set a strong value before launch — or host the CRM
# separately instead of on the public site.
VITE_CRM_PASSCODE_HASH=your_crm_passcode_hash_here
